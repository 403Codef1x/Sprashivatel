# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте и не выкладывайте в git.

# Токен бота (обязательно)
MAX_BOT_TOKEN=

# Имя бота без @ — нужно для ссылок на опросы
BOT_USERNAME=ideya_fiks_109_bot

# Кому присылать технические сообщения об ошибках (id через запятую, можно оставить пустым)
ADMIN_IDS=

# Часовой пояс
TIMEZONE=Europe/Moscow

# Автоудаление ответов старше N дней (0 — не удалять)
ANSWERS_RETENTION_DAYS=0
